{
  "$ref": "#/definitions/freshness",
  "definitions": {
    "freshness": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "fresh",
            "stale:commits",
            "stale:dirty",
            "stale:both",
            "empty",
            "unknown"
          ]
        },
        "commits_behind": {
          "type": "number"
        },
        "dirty": {
          "type": "boolean"
        },
        "indexed_at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "source_drift": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "current",
                "behind",
                "unknown"
              ]
            },
            "base_ref": {
              "type": "string"
            },
            "base_source": {
              "type": "string",
              "enum": [
                "upstream",
                "origin_head",
                "probe"
              ]
            },
            "commits_behind": {
              "type": "number"
            },
            "fork_age_days": {
              "type": "number"
            },
            "base_ref_age_days": {
              "type": "number"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "state"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
