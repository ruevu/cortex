{
  "name": "cortex",
  "version": "2.4.1",
  "description": "Knowledge graph MCP server with decision provenance",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cortex": "bin/cortex"
  },
  "scripts": {
    "postinstall": "node scripts/fetch-indexer.mjs && node scripts/install-git-hooks.mjs",
    "fetch-indexer": "node scripts/fetch-indexer.mjs",
    "install-git-hooks": "node scripts/install-git-hooks.mjs",
    "build": "tsc && cp src/events/worker-bootstrap.mjs dist/events/ && cp src/events/worker/schema.sql dist/events/worker/",
    "start": "node dist/index.js",
    "dev": "CORTEX_VIEWER_PORT=3334 tsx src/index.ts",
    "dev:viewer": "vite dev src/viewer",
    "build:viewer": "vite build src/viewer",
    "eval": "tsx evals/src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api-schemas": "tsx scripts/gen-api-schemas.ts",
    "survey:phase1": "tsx scripts/frame-extraction/survey.ts",
    "survey:report": "tsx scripts/frame-extraction/report.ts",
    "co-change": "tsx src/frame-extraction/co-change.ts",
    "cluster:tfidf": "tsx src/frame-extraction/cluster-tfidf-hdbscan.ts",
    "eval:phase2": "tsx scripts/frame-extraction/eval.ts",
    "eval:frames": "tsx scripts/frame-extraction/eval-all.ts",
    "setup-python": "bash scripts/frame-extraction/python/setup-venv.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@vscode/ripgrep": "^1.18.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.0",
    "ulid": "^3.0.2",
    "ws": "^8.20.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.15.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.1.2",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.14"
  }
}
